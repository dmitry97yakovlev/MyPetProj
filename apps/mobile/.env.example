# Адрес backend API.
# Для симулятора/эмулятора на этой же машине localhost подходит.
# Для физического устройства в той же Wi-Fi сети укажи IP машины, например:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In — необязательно. Без них кнопка "Продолжить с Google" покажет
# понятную ошибку вместо краша. Заполнить client ID из Google Cloud Console
# (см. README, раздел "Sign in with Apple / Google").
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
