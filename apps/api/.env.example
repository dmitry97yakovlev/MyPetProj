DATABASE_URL="postgresql://mypetproj:mypetproj@localhost:5433/mypetproj?schema=public"
# Порт 5433, а не стандартный 5432 — см. комментарий в docker-compose.yml
# (на случай, если 5432 у тебя уже занят другим Postgres).
JWT_ACCESS_SECRET="change-me-to-a-random-string-at-least-16-chars"
PORT=4000
NODE_ENV=development

# Необязательно — без них /auth/apple и /auth/google просто отвечают 501,
# остальное приложение работает как обычно. Заполнить, когда заведёшь
# Apple Developer Services ID и Google Cloud OAuth client ID (см. README).
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
