generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  displayName  String?
  isAdmin      Boolean  @default(false)

  // Заделы под будущий вход через соцсети (см. CLAUDE.md, раздел про авторизацию)
  appleId  String? @unique
  googleId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  ownedEpicWins      EpicWin[]        @relation("EpicWinOwner")
  epicWinMemberships EpicWinMember[]
  taskCompletions    TaskCompletion[]
  journalEntries     JournalEntry[]
  moodEntries        MoodEntry[]
  assignedQuests     Quest[]         @relation("QuestAssignee")
  sentFriendRequests     FriendRequest[] @relation("FriendRequestsSent")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestsReceived")

  @@map("users")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FriendRequest {
  id         String              @id @default(uuid())
  fromUserId String
  fromUser   User                @relation("FriendRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User                @relation("FriendRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromUserId, toUserId])
  @@map("friend_requests")
}

enum EpicWinStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model EpicWin {
  id          String        @id @default(uuid())
  ownerId     String
  owner       User          @relation("EpicWinOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  deadline    DateTime?
  status      EpicWinStatus @default(ACTIVE)
  // Приоритет — выше число, выше в списке на главном экране; также взвешивает
  // вклад задач этого Эпика в дневную результативность (см. dailyTasks.service.ts).
  priority    Int           @default(0)

  // Необязательный числовой показатель цели (например, вес в кг) — если задан,
  // прогресс Эпика считается по нему (см. epicWins.service.ts), а не по доле
  // завершённых квестов. Значения "сейчас" берутся из последней отметки
  // ежедневной задачи с tracksEpicMetric=true внутри квестов этого Эпика.
  metricUnit        String?
  metricStartValue  Float?
  metricTargetValue Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quests  Quest[]
  members EpicWinMember[]

  @@map("epic_wins")
}

enum EpicWinRole {
  OWNER
  MEMBER
}

// Участники совместной Epic Win (для целей с друзьями). Владелец тоже
// присутствует здесь отдельной строкой с role=OWNER — упрощает проверки доступа.
model EpicWinMember {
  id        String      @id @default(uuid())
  epicWinId String
  epicWin   EpicWin     @relation(fields: [epicWinId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      EpicWinRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  @@unique([epicWinId, userId])
  @@map("epic_win_members")
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
}

model Quest {
  id          String      @id @default(uuid())
  epicWinId   String
  epicWin     EpicWin     @relation(fields: [epicWinId], references: [id], onDelete: Cascade)
  title       String
  description String?
  deadline    DateTime?
  status      QuestStatus @default(ACTIVE)
  position    Int         @default(0)
  // "Вес" квеста в днях — на сколько сегментов и какого размера делится
  // таймлайн-полоска прогресса Эпика (см. epicWins.service.ts). Не строгий
  // дедлайн, а прикидка длительности: квест на 30 дней займёт на полоске
  // втрое больше места, чем квест на 10 дней.
  estimatedDays Int @default(1)

  // Кому из участников совместного Эпика "принадлежит" этот квест — для
  // распределения задач между друзьями. null = не назначен никому конкретно.
  assignedToUserId String?
  assignedTo       User?   @relation("QuestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyTasks DailyTask[]

  @@map("quests")
}

enum DailyTaskCategory {
  MANDATORY
  OPTIONAL
  SMALL
  SUDDEN
}

model DailyTask {
  id          String  @id @default(uuid())
  questId     String
  quest       Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isActive    Boolean @default(true)
  // Группа для отображения на экране "Сегодня" (см. journal.service.ts todayTasksByCategory).
  category DailyTaskCategory @default(MANDATORY)

  // Задана — задача "по количеству": пользователь при выполнении вводит
  // число (например, км, минуты, кг). unit — подпись единицы для UI.
  unit String?

  // Если true — последнее введённое количество по этой задаче считается
  // "текущим значением показателя" родительского Эпика (см. EpicWin.metric*
  // и epicWins.service.ts) — например, отметка веса для Эпика похудения.
  tracksEpicMetric Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions TaskCompletion[]

  @@map("daily_tasks")
}

model TaskCompletion {
  id          String    @id @default(uuid())
  dailyTaskId String
  dailyTask   DailyTask @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Количество за этот день для задач "по количеству" (напр. 5 км). Null для
  // обычных задач-чекбоксов.
  quantity Float?

  // Календарный день выполнения (полночь UTC) — не даёт отметить дважды за день.
  completedOn DateTime
  createdAt   DateTime  @default(now())

  @@unique([dailyTaskId, userId, completedOn])
  @@map("task_completions")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Хранится только хэш refresh-токена, не сам токен.
  refreshTokenHash String @unique

  // null = "неограниченная сессия" (никогда не истекает).
  // Иначе — дата истечения обычной сессии.
  expiresAt DateTime?

  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@map("sessions")
}

enum JournalEntryKind {
  TEXT
  VOICE
}

// Дневник: свободные записи-мысли пользователя (текст или голос) — не
// связаны с задачами/квестами напрямую. Автоматически залогированные
// выполнения задач/квестов/эпиков за день вычисляются на лету в
// journal.service.ts, а не хранятся здесь отдельными записями.
model JournalEntry {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   JournalEntryKind @default(TEXT)

  // Текст мысли (TEXT) или необязательная подпись к голосовой записи (VOICE).
  content String?
  // Относительный путь к аудиофайлу на сервере (только для kind=VOICE).
  audioUrl String?
  // Автоматическая расшифровка голоса в текст (Groq Whisper, если настроен
  // GROQ_API_KEY) — чтобы будущий AI-агент мог читать дневник целиком.
  transcript String?

  // Календарный день записи (полночь UTC) — для группировки в UI по дням.
  entryDate DateTime
  createdAt DateTime @default(now())

  @@map("journal_entries")
}

// Дневная самооценка эмоциональной стабильности (1..10) — не диагностика,
// просто личный трекер настроения, одна запись в день, перезаписывается при
// повторной отметке в тот же день.
model MoodEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int // 1..10
  date  DateTime // полночь UTC — календарный день

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("mood_entries")
}
